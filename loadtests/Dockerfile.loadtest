# Load generator image.
#
# Installs the application dependencies from the same pyproject.toml/poetry.lock
# as the app image (so JWTManager, UserJWTData, chat_config and the SQLAlchemy
# models are importable and the token/schema contract is not duplicated), then
# adds the load-test-only packages on top.
#
# Build context is the repository root:
#   docker compose -f docker-compose.yaml -f docker-compose.loadtest.yaml build locust
FROM python:3.14-rc-slim AS loadtest

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POETRY_HOME="/opt/poetry" \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1 \
    PYTHONPATH=/app

ENV PATH="$POETRY_HOME/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc git curl libmagic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/pysetup
COPY pyproject.toml poetry.lock ./

RUN python -m pip install --no-cache-dir poetry==2.2.1 \
    && poetry install --without dev --without test --no-root --no-ansi

COPY loadtests/requirements.txt /tmp/loadtests-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/loadtests-requirements.txt

WORKDIR /app
COPY app/ ./app/
COPY loadtests/ ./loadtests/

CMD ["locust", "--version"]
